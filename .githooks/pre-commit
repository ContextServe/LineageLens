#!/bin/bash
set -e

# Pre-commit hook for LineageLens.
#
# Three checks, in cost order. The frontend test step and the dead-code ratchet
# are gone: the React UI and the ratchet were both built on the schema-3 core
# and were removed with it.

VENV_BIN="./.venv/bin"
if [ -d "$VENV_BIN" ]; then
    PYTEST="$VENV_BIN/pytest"
    RUFF="$VENV_BIN/ruff"
    PYTHON="$VENV_BIN/python"
else
    PYTEST="pytest"
    RUFF="ruff"
    PYTHON="python"
fi

echo "1/3 ruff"
$RUFF check src tests

echo "2/3 pytest"
$PYTEST -q

# The capability matrix is what `get_ontology` serves. A stale one means agents
# read a contract that no longer describes the code -- the schema-3 ontology
# failure in a different file format. Regenerating must produce no diff.
echo "3/3 capability matrix is current"
$PYTHON -c "import sys; from lineagelens.conformance.runner import main; sys.exit(main())" >/dev/null
git diff --exit-code src/lineagelens/conformance/matrix.json

echo "pre-commit OK"
